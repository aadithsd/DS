#include <stdio.h>
#include <conio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *llink;
    struct Node *rlink;
};

struct Node *head = NULL;

struct Node* createNode(int value)
{
    struct Node *newNode;
    newNode = (struct Node*) malloc(sizeof(struct Node));
    newNode->data = value;
    newNode->llink = NULL;
    newNode->rlink = NULL;
    return newNode;
}

void insertAtBeginning(int value)
{
    struct Node *newNode;
    newNode = createNode(value);

    if (head == NULL) {
        head = newNode;
    } else {
        newNode->rlink = head;
        head->llink = newNode;
        head = newNode;
    }

    printf("\nNode inserted at beginning.");
}

void insertAtEnd(int value)
{
    struct Node *newNode;
    struct Node *temp;
    newNode = createNode(value);

    if (head == NULL) {
        head = newNode;
        return;
    }

    temp = head;
    while (temp->rlink != NULL) {
        temp = temp->rlink;
    }

    temp->rlink = newNode;
    newNode->llink = temp;
    printf("\nNode inserted at end.");
}

void insertAtPosition(int value, int pos)
{
    struct Node *newNode;
    struct Node *temp;
    int i;
    newNode = createNode(value);

    if (pos == 1) {
        insertAtBeginning(value);
        return;
    }

    temp = head;
    i = 1;
    while (i < pos - 1 && temp != NULL) {
        temp = temp->rlink;
        i = i + 1;
    }

    if (temp == NULL) {
        printf("\nPosition out of range.");
        return;
    }

    newNode->rlink = temp->rlink;
    if (temp->rlink != NULL) {
        struct Node *nextNode;
        nextNode = temp->rlink;
        nextNode->llink = newNode;
    }

    temp->rlink = newNode;
    newNode->llink = temp;

    printf("\nNode inserted at position %d.", pos);
}

void deleteAtBeginning()
{
    struct Node *temp;

    if (head == NULL) {
        printf("\nList is empty.");
        return;
    }

    temp = head;
    head = temp->rlink;

    if (head != NULL) {
        head->llink = NULL;
    }

    free(temp);
    printf("\nNode deleted from beginning.");
}

void deleteAtEnd()
{
    struct Node *temp;
    struct Node *prevNode;

    if (head == NULL) {
        printf("\nList is empty.");
        return;
    }

    temp = head;
    if (temp->rlink == NULL) {
        head = NULL;
        free(temp);
        printf("\nNode deleted from end.");
        return;
    }

    while (temp->rlink != NULL) {
        temp = temp->rlink;
    }

    prevNode = temp->llink;
    prevNode->rlink = NULL;
    free(temp);
    printf("\nNode deleted from end.");
}

void deleteAtPosition(int pos)
{
    struct Node *temp;
    struct Node *nextNode;
    struct Node *prevNode;
    int i;

    if (head == NULL) {
        printf("\nList is empty.");
        return;
    }

    if (pos == 1) {
        deleteAtBeginning();
        return;
    }

    temp = head;
    i = 1;
    while (i < pos && temp != NULL) {
        temp = temp->rlink;
        i = i + 1;
    }

    if (temp == NULL) {
        printf("\nPosition out of range.");
        return;
    }

    nextNode = temp->rlink;
    prevNode = temp->llink;

    if (nextNode != NULL) {
        nextNode->llink = prevNode;
    }

    if (prevNode != NULL) {
        prevNode->rlink = nextNode;
    }

    free(temp);
    printf("\nNode deleted from position %d.", pos);
}

void search(int key)
{
    struct Node *temp;
    int pos;
    pos = 1;
    temp = head;

    while (temp != NULL) {
        if (temp->data == key) {
            printf("\nElement %d found at position %d.", key, pos);
            return;
        }
        temp = temp->rlink;
        pos = pos + 1;
    }

    printf("\nElement %d not found.", key);
}

void display()
{
    struct Node *temp;
    temp = head;

    if (temp == NULL) {
        printf("\nList is empty.");
        return;
    }

    printf("\nDoubly Linked List: ");
    while (temp != NULL) {
        printf("%d <-> ", temp->data);
        temp = temp->rlink;
    }
    printf("NULL");
}

int main()
{
    int choice, data, pos;
    clrscr();

    while (1) {
        printf("\n\n--- DOUBLY LINKED LIST MENU ---");
        printf("\n1. Insert at Beginning");
        printf("\n2. Insert at End");
        printf("\n3. Insert at Position");
        printf("\n4. Delete at Beginning");
        printf("\n5. Delete at End");
        printf("\n6. Delete at Position");
        printf("\n7. Search");
        printf("\n8. Display");
        printf("\n9. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            printf("Enter data: ");
            scanf("%d", &data);
            insertAtBeginning(data);
        } else if (choice == 2) {
            printf("Enter data: ");
            scanf("%d", &data);
            insertAtEnd(data);
        } else if (choice == 3) {
            printf("Enter data and position: ");
            scanf("%d %d", &data, &pos);
            insertAtPosition(data, pos);
        } else if (choice == 4) {
            deleteAtBeginning();
        } else if (choice == 5) {
            deleteAtEnd();
        } else if (choice == 6) {
            printf("Enter position: ");
            scanf("%d", &pos);
            deleteAtPosition(pos);
        } else if (choice == 7) {
            printf("Enter element to search: ");
            scanf("%d", &data);
            search(data);
        } else if (choice == 8) {
            display();
        } else if (choice == 9) {
            exit(0);
        } else {
            printf("\nInvalid choice.");
        }
    }

    getch();
    return 0;
}
