//BUBBLE SORT
#include <stdio.h>
#include <conio.h>

void main() {
    int arr[5] = {64, 25, 12, 22, 11};
    int i, j, temp;

    clrscr();

    for(i = 0; i < 4; i++) {
        for(j = 0; j < 4-i; j++) {
            if(arr[j] > arr[j+1]) {
                temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            }
        }
    }

    printf("Sorted Array: ");
    for(i = 0; i < 5; i++)
        printf("%d ", arr[i]);

    getch();
}


//INSERION SORT

#include <stdio.h>
#include <conio.h>

void main() {
    int arr[5] = {9, 5, 1, 4, 3};
    int i, j, key;

    clrscr();

    for(i = 1; i < 5; i++) {
        key = arr[i];
        j = i - 1;

        while(j >= 0 && arr[j] > key) {
            arr[j+1] = arr[j];
            j--;
        }
        arr[j+1] = key;
    }

    printf("Sorted Array: ");
    for(i = 0; i < 5; i++)
        printf("%d ", arr[i]);

    getch();
}



//SELECTION

#include <stdio.h>
#include <conio.h>

void main() {
    int arr[5] = {29, 10, 14, 37, 13};
    int i, j, min, temp;

    clrscr();

    for(i = 0; i < 4; i++) {
        min = i;
        for(j = i+1; j < 5; j++) {
            if(arr[j] < arr[min])
                min = j;
        }
        temp = arr[i];
        arr[i] = arr[min];
        arr[min] = temp;
    }

    printf("Sorted Array: ");
    for(i = 0; i < 5; i++)
        printf("%d ", arr[i]);

    getch();
}



//SHELL SORT

#include <stdio.h>
#include <conio.h>

int main()
{
    int arr[50], n, i, j, gap, temp;
    clrscr();

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);
    for(i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    for(gap = n / 2; gap > 0; gap /= 2)
    {
        for(i = gap; i < n; i++)
        {
            for(j = i - gap; j >= 0; j = j - gap)
            {
                if(arr[j + gap] > arr[j])
                    break;
                else
                {
                    temp = arr[j];
                    arr[j] = arr[j + gap];
                    arr[j + gap] = temp;
                }
            }
        }
    }

    printf("\nSorted elements:\n");
    for(i = 0; i < n; i++)
        printf("%d ", arr[i]);

    getch();
    return 0;
}

